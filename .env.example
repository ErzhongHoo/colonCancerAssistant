DASHSCOPE_API_KEY=your_api_key
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
VISION_MODEL=qwen-vl-max
EMBEDDING_MODEL=text-embedding-v3
LITERATURE_AGENT_TOPIC_QUERY=(colorectal cancer OR colon cancer OR rectal cancer) AND (clinical OR guideline OR trial OR treatment)
ENABLE_IMAGE_DATE_VLM=true
ENABLE_LLM_TIMELINE=true
SAVE_UPLOAD_ORIGINALS=false
OCR_PROVIDER=auto
PADDLE_OCR_LANG=ch
PDF_OCR_MAX_PAGES=500
ALIYUN_OCR_MODEL=qwen-vl-ocr-latest
ALIYUN_OCR_MIN_PIXELS=3072
ALIYUN_OCR_MAX_PIXELS=8388608
OPENVIKING_NATIVE_ENABLED=true
OPENVIKING_NATIVE_STORAGE_PATH=./data/openviking_native
OPENVIKING_NATIVE_AGFS_PORT=1833
OPENVIKING_NATIVE_CALL_TIMEOUT_SECONDS=12
OPENVIKING_NATIVE_COOLDOWN_SECONDS=30
OPENVIKING_INTERNAL_COMPLEX_SEARCH=false

# JWT Authentication (auto-generated if not set, but set it for persistence across restarts)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE_SECONDS=604800
